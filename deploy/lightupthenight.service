[Unit]
Description=Light Up The Night arm controller
After=multi-user.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/light-up-the-night
Environment=PYTHONPATH=/opt/light-up-the-night/src
ExecStart=/usr/bin/python3 -m lightupthenight --config /etc/lightupthenight/config.json

[Install]
WantedBy=multi-user.target
